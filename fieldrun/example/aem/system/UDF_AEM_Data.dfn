DEFN 16 ST=RECD,RT=;Frame_Height:F10.2:UNIT=metres,NAME=Laser altimeter measured height of the Tx loop averaged to centre above ground
DEFN 17 ST=RECD,RT=;DTM_AHD:F10.2:UNIT=metres,NAME=Digital terrain model (Australian Height Datum)
DEFN 18 ST=RECD,RT=;AngleX:F10.2:UNIT=degrees,NAME=Tilt of frame from horizontal in flight line direction - Tx loop nose up is positive
DEFN 19 ST=RECD,RT=;AngleY:F10.2:UNIT=degrees,NAME=Tilt of frame from horizontal perpendicular to flight line direction - Tx loop port side up is positive
DEFN 20 ST=RECD,RT=;Ground_Speed:F10.2:UNIT=km/h,NAME=Frame ground speed
DEFN 21 ST=RECD,RT=;TxRx_Dx:F7.2:UNIT=metres,NAME=Horizontal in-line transmitter to receiver separation - positive in flight line direction
DEFN 22 ST=RECD,RT=;TxRx_Dy:F7.2:UNIT=metres,NAME=Horizontal transverse transmitter to receiver separation - positive toward the starboard
DEFN 23 ST=RECD,RT=;TxRx_Dz:F7.2:UNIT=metres,NAME=Vertical transmitter to receiver separation - positive downward
DEFN 24 ST=RECD,RT=;Curr_LM:F10.2:UNIT=A,NAME=Low moment peak transmitter current
DEFN 25 ST=RECD,RT=;Curr_HM:F10.2:UNIT=A,NAME=High moment peak transmitter current
DEFN 26 ST=RECD,RT=;Powerline_Monitor:F10.2:NAME=Power line noise indicator
