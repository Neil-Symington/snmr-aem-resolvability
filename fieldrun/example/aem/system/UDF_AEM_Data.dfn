DEFN 29 ST=RECD,RT=;HM_X:23F15.5:UNIT=pV/A.turns.m4,NAME=X-comp HM dB/dt processed and normalised
DEFN 30 ST=RECD,RT=;HM_Z:23F15.5:UNIT=pV/A.turns.m4,NAME=Z-comp HM dB/dt processed and normalised
DEFN 31 ST=RECD,RT=;RUNC_LM_X:18F15.5:UNIT=fraction,NAME=X-comp LM dB/dt relative uncertainty (noise estimate as a fraction of the measured response)
