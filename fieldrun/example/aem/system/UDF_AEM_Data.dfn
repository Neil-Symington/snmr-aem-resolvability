DEFN 8 ST=RECD,RT=;Time_Local:F12.2:UNIT=HHMMSS.ss,NAME=Local Time
DEFN 9 ST=RECD,RT=;Time_UTC:F12.2:UNIT=HHMMSS.ss,NAME=UTC Time
DEFN 10 ST=RECD,RT=;DateTime:F18.10:NAME=Decimal days since midnight 31/12/1899
